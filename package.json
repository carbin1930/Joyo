{
  "name": "joyo",
  "private": true,
  "version": "0.1.0",
  "description": "Joyo - 开源 MySQL 桌面客户端（Electron + Vue3 + Spring Boot Sidecar）",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "test:frontend": "pnpm --filter frontend test",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "build:desktop": "pnpm --filter desktop build",
    "dev:desktop": "pnpm --filter desktop dev"
  },
  "engines": {
    "node": ">=20"
  }
}
