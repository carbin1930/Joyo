{
  "name": "desktop",
  "productName": "joyo",
  "private": true,
  "version": "0.1.0",
  "description": "Joyo Electron 桌面壳（主进程 + preload）",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "test": "vitest run",
    "package": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.6.3",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.joyo.app",
    "productName": "Joyo",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/target/joyo-backend.jar",
        "to": "bin/joyo-backend.jar"
      },
      {
        "from": "../backend-runtime",
        "to": "backend-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Joyo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "carbin1930",
        "repo": "Joyo"
      }
    ]
  }
}
